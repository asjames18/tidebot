# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=     # OpenRouter key (sk-or-v1-...) for 250+ models
OPENROUTER_MODEL=thinkingmachines/inkling-2-small:free
LLM_BASE_URL=           # Optional custom OpenAI-compatible base URL (Ollama, LM Studio, vLLM)
LLM_API_KEY=
LLM_MODEL=
XAI_API_KEY=            # Optional xAI console key
XAI_MODEL=grok-4.7
COMPOSIO_API_KEY=       # Composio project key (ak_...): sign-in, connectors, app marketplace
ORGO_API_KEY=           # Orgo key (sk_live_...) that can create computers in ORGO_WORKSPACE_ID
ORGO_WORKSPACE_ID=      # Orgo workspace holding every user's box
ORGO_RAM_GB=8           # box size: 8 GB / 2 vCPU (Medium); 16/4 recommended for 4 active bots
ORGO_CPU=2
ORGO_RESOLUTION=1280x800x24
PORT=8787
APP_URL=http://localhost:5173     # where the web app is served (redirect target after sign-in)
SERVER_URL=http://localhost:8787  # public URL of this server (OAuth callbacks)
SESSION_SECRET=         # openssl rand -hex 32
# DEV_LOGIN=1           # opt-in only: enables POST /api/auth/dev (local testing only, never in production)
# HOST=127.0.0.1        # bind address; set 0.0.0.0 only behind a reverse proxy / firewall
STUDIO_EMAIL=you@example.com   # local sign-in email (single-operator, this machine only)
STUDIO_PASSWORD=               # local sign-in password; sign-in is disabled while empty
