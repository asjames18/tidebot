{
  "name": "tidebot-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "TideBot Desktop for Windows, macOS, and Linux with GitHub auto-updates",
  "homepage": "https://github.com/asjames18/tidebot",
  "author": "TideBot <noreply@users.noreply.github.com>",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "start": "electron .",
    "pack": "node scripts/stage.mjs && electron-builder --dir",
    "dist": "node scripts/stage.mjs && electron-builder",
    "dist:win": "node scripts/stage.mjs && electron-builder --win",
    "dist:mac": "node scripts/stage.mjs && electron-builder --mac",
    "dist:linux": "node scripts/stage.mjs && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.tidebot.desktop",
    "productName": "TideBot",
    "afterPack": "./scripts/check-server-bundle.cjs",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "connection.cjs",
      "connection-preload.cjs",
      "connection.html",
      "connection.js",
      "git-repository.cjs",
      "git-review.cjs",
      "git-review-preload.cjs",
      "git-review.html",
      "git-review.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "staged/server",
        "to": "server",
        "filter": [
          "dist/**/*",
          "package.json"
        ]
      },
      {
        "from": "staged/server/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*",
          "!**/.bin/**",
          "!**/.package-lock.json"
        ]
      },
      {
        "from": "staged/web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "asjames18",
        "repo": "tidebot",
        "releaseType": "prerelease"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
